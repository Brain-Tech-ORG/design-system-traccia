{
  "$description": "LA TRACCIA — Design Tokens (formato W3C draft). Regola: mai introdurre altri hue; varianti solo in oklch mantenendo lo hue del blu logo.",
  "color": {
    "brand": {
      "500": { "$value": "#4194d7", "$type": "color", "$description": "Blu logo. Unico accento: evidenze, numeri, linee di quota, dot, icone." },
      "300": { "$value": "#8fc0e7", "$type": "color", "$description": "Tinta chiara per linee secondarie." },
      "100": { "$value": "#d0e4f5", "$type": "color", "$description": "Tinta pallida decorativa." },
      "600": { "$value": "#2f7ab8", "$type": "color", "$description": "Tinta scura dello stesso hue: testo piccolo e superfici piene con testo bianco (contrasto >= 4.5:1)." },
      "700": { "$value": "#266296", "$type": "color", "$description": "Tinta scura dello stesso hue: hover delle superfici piene." }
    },
    "state": {
      "$description": "Unica eccezione ammessa alla regola del singolo hue, riservata all interfaccia software (validazione form, esiti di sistema). Mai su brochure, slide o stampa.",
      "danger": { "$value": "#a53a3a", "$type": "color", "$description": "Errore, campo non valido." },
      "warning": { "$value": "#99631d", "$type": "color", "$description": "Avviso, azione da confermare." },
      "success": { "$value": "#2f6b45", "$type": "color", "$description": "Esito positivo." }
    },
    "surface": {
      "tint": { "$value": "#eff2f9", "$type": "color", "$description": "Solo riempimenti piccoli (cerchietti numerati, silhouette). MAI per sfondi di card o pannelli." }
    },
    "border": {
      "soft": { "$value": "#dde2ee", "$type": "color", "$description": "Filetti e bordi leggeri." },
      "soft-2": { "$value": "#c9cede", "$type": "color", "$description": "Filetti leggeri, variante più scura." }
    },
    "ink": {
      "900": { "$value": "#1b1f2a", "$type": "color", "$description": "Testo primario e tratti dei disegni tecnici." },
      "600": { "$value": "#3a4050", "$type": "color", "$description": "Testo secondario / body." },
      "400": { "$value": "#565c6b", "$type": "color", "$description": "Didascalie e metadati." }
    },
    "paper": { "$value": "#fbfbfd", "$type": "color", "$description": "Sfondo pagina." }
  },
  "font": {
    "family": {
      "display": { "$value": "Archivo, system-ui, sans-serif", "$type": "fontFamily", "$description": "Display, UI e body. Pesi 400–800." },
      "mono": { "$value": "'IBM Plex Mono', ui-monospace, monospace", "$type": "fontFamily", "$description": "Tecnico ed etichette. Pesi 400–600. Sempre maiuscolo con tracking ampio." }
    },
    "weight": {
      "body": { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "display": { "$value": 800, "$type": "fontWeight" }
    },
    "tracking": {
      "display": { "$value": "-0.015em", "$description": "Titoli maiuscoli." },
      "mono": { "$value": "0.08em", "$description": "Etichette mono base (range 0.06–0.3em)." },
      "monoWide": { "$value": "0.22em", "$description": "Eyebrow / kicker." },
      "wordmark": { "$value": "0.08em", "$description": "Wordmark LA TRACCIA." }
    },
    "leading": {
      "display": { "$value": 1.08, "$description": "Titoli (range 1.04–1.15)." },
      "body": { "$value": 1.6, "$description": "Body (range 1.5–1.65)." }
    },
    "size": {
      "ui": {
        "caption": { "$value": "12px" },
        "mono": { "$value": "13px" },
        "body": { "$value": "15px", "$description": "UI 14–16px." },
        "lead": { "$value": "18px" },
        "h3": { "$value": "22px" },
        "h2": { "$value": "32px" },
        "h1": { "$value": "48px" }
      },
      "print": { "body": { "$value": "12–14px" } },
      "slide": {
        "body": { "$value": "24–30px" },
        "minimo": { "$value": "17px", "$description": "Su slide 16:9 (1920×1080) mai testo sotto 17px." },
        "titolo": { "$value": "60–92px" }
      }
    }
  },
  "space": {
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "24px" }, "6": { "$value": "32px" },
    "7": { "$value": "48px" }, "8": { "$value": "64px" }, "9": { "$value": "96px" }
  },
  "radius": {
    "line": { "$value": "99px", "$description": "Estremità stondate di filetti e segmenti." },
    "pill": { "$value": "999px", "$description": "Chip a pillola." },
    "soft": { "$value": "20px", "$description": "Angoli smussati (range 16–26px)." },
    "photo": { "$value": "28px", "$description": "Cornice foto ambientata (range 22–36px)." }
  },
  "stroke": {
    "thin": { "$value": "1px", "$description": "Filetti orizzontali (1–2px)." },
    "medium": { "$value": "2px", "$description": "Segmenti decorativi verticali." },
    "accent": { "$value": "3px", "$description": "Tratti d'accento e linee di quota (1.5–3px)." },
    "drawing": { "$value": "2.25px", "$description": "Tratto disegni tecnici (2–2.5px)." }
  },
  "watermark": {
    "opacity": { "$value": 0.16, "$description": "Opacità della sagoma outline del logo usata negli sfondi di brochure e slide." },
    "stroke": { "$value": "6px", "$description": "Spessore del tratto dell'outline (riferito al viewBox 1280 di logo-traccia-outline.svg)." }
  },
  "login": {
    "clientLogo": { "$value": "40px", "$description": "Altezza del marchio del cliente nella testata delle pagine di login (range 32-48px)." },
    "panel": { "$value": "420px", "$description": "Larghezza della colonna del form di login." }
  },
  "measure": {
    "accentDash": { "$value": "64px", "$description": "Tratto d'accento sopra i titoli di sezione." },
    "dot": { "$value": "8px", "$description": "Dot bullet (range 6–13px)." },
    "circle": {
      "sm": { "$value": "28px" }, "md": { "$value": "40px" }, "lg": { "$value": "52px" },
      "$description": "Cerchietti numerati (range 24–52px)."
    }
  }
}
